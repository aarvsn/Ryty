{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "RTY_BUILD_GUI": "ON"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "displayName": "Linux release (CLI + tests + GUI when Qt6 is present)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-release-cli",
            "inherits": "base",
            "displayName": "Linux release, CLI only (no Qt, no GUI)",
            "cacheVariables": {
                "RTY_BUILD_GUI": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-release",
            "inherits": "base",
            "displayName": "Windows release (MSYS2 UCRT64)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-release-cli",
            "configurePreset": "linux-release-cli"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        }
    ],
    "testPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-release-cli",
            "configurePreset": "linux-release-cli",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
